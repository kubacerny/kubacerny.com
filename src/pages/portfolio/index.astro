---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import { getCollection } from 'astro:content';
import { CATEGORIES, type Category } from '../../lib/categories';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const tabs = [
  { key: 'all', label: 'Vše', count: posts.length },
  ...(Object.keys(CATEGORIES) as Category[]).map((key) => ({
    key,
    label: CATEGORIES[key].label,
    count: posts.filter((p) => p.data.category === key).length,
  })),
];
---

<Layout
  title="Portfolio — Jakub Černý"
  description="Vybrané projekty a case studies — AI a vyhledávání, infrastruktura, vývoj aplikací na míru."
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <header class="max-w-2xl mb-10">
      <p class="text-sm font-medium tracking-wider uppercase text-brand-600 mb-3">Portfolio</p>
      <h1 class="font-serif text-4xl sm:text-5xl text-brand-900 mb-4">Projekty a case studies</h1>
      <p class="text-lg text-brand-700 leading-relaxed">
        Ukázky toho, co jsem stavěl — od&nbsp;vyhledávání a&nbsp;AI
        přes infrastrukturu po&nbsp;aplikace na&nbsp;míru. U&nbsp;každého
        projektu popisuji, jak jsem ho řešil a&nbsp;co to klientovi přineslo.
      </p>
    </header>

    <div
      role="tablist"
      aria-label="Filtr projektů"
      class:list={[
        'flex flex-wrap gap-2 mb-10 border-b border-brand-200 pb-4',
        posts.length === 0 && 'hidden',
      ]}
      data-filter-tabs
    >
      {tabs.map((tab, i) => (
        <button
          type="button"
          role="tab"
          data-filter={tab.key}
          data-active={i === 0 ? 'true' : 'false'}
          aria-selected={i === 0 ? 'true' : 'false'}
          class="px-4 py-2 rounded-full text-sm font-medium transition-colors data-[active=true]:bg-brand-800 data-[active=true]:text-white data-[active=false]:text-brand-700 data-[active=false]:hover:bg-brand-100"
        >
          {tab.label}
          <span class="ml-1.5 text-xs opacity-70">({tab.count})</span>
        </button>
      ))}
    </div>

    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-filter-grid>
      {posts.map((post) => (
        <div data-category={post.data.category}>
          <BlogCard
            href={`/portfolio/${post.id}`}
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            category={post.data.category}
            cover={post.data.cover}
          />
        </div>
      ))}
    </div>

    <p class="hidden text-center text-brand-600 py-12" data-filter-empty>
      V&nbsp;této kategorii zatím nic není.
    </p>

    {posts.length === 0 && (
      <div class="bg-brand-100/50 rounded-2xl p-8 sm:p-12 text-center">
        <h2 class="font-serif text-2xl text-brand-900 mb-3">Case studies se připravují</h2>
        <p class="text-brand-700 leading-relaxed max-w-xl mx-auto mb-6">
          První projekty sem právě sepisuji. Mezitím se podívejte, s&nbsp;čím
          vám umím pomoct — nebo se rovnou zeptejte na&nbsp;konkrétní zkušenost.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="/sluzby" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-brand-700 text-white font-medium hover:bg-brand-800 transition-colors">
            Přehled služeb <span aria-hidden>→</span>
          </a>
          <a href="/kontakt" class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white text-brand-800 font-medium border border-brand-200 hover:bg-brand-100 transition-colors">
            Kontakt <span aria-hidden>→</span>
          </a>
        </div>
      </div>
    )}
  </section>
</Layout>

<script>
  const tabsEl = document.querySelector<HTMLElement>('[data-filter-tabs]');
  const grid = document.querySelector<HTMLElement>('[data-filter-grid]');
  const emptyEl = document.querySelector<HTMLElement>('[data-filter-empty]');
  if (tabsEl && grid && emptyEl) {
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('[data-category]'));

    const applyFilter = (key: string) => {
      let visible = 0;
      cards.forEach((card) => {
        const match = key === 'all' || card.dataset.category === key;
        card.hidden = !match;
        if (match) visible++;
      });
      emptyEl.classList.toggle('hidden', visible > 0);
    };

    tabsEl.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((btn) => {
      btn.addEventListener('click', () => {
        tabsEl.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => {
          const active = b === btn;
          b.dataset.active = active ? 'true' : 'false';
          b.setAttribute('aria-selected', active ? 'true' : 'false');
        });
        applyFilter(btn.dataset.filter ?? 'all');
      });
    });
  }
</script>

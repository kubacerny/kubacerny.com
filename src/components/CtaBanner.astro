---
interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'Pojďme to probrat',
  text = 'První konzultace je nezávazná a zdarma. Projdeme váš záměr a navrhnu nejjednodušší cestu k cíli.',
} = Astro.props;
---

<section class="mx-auto max-w-6xl px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
  <div class="bg-brand-800 rounded-3xl p-8 sm:p-12 text-center text-white">
    <h2 class="font-serif text-3xl sm:text-4xl mb-4">{title}</h2>
    <p class="text-brand-200 max-w-2xl mx-auto mb-8 leading-relaxed">{text}</p>
    <a
      href="/kontakt"
      class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-white text-brand-800 font-medium hover:bg-brand-100 transition-colors"
    >
      Kontaktujte mě <span aria-hidden>→</span>
    </a>
  </div>
</section>
